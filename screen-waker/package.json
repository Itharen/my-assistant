{
  "name": "@my-assistant/screen-waker",
  "version": "0.1.0",
  "description": "Local Windows webcam motion detector that wakes the display.",
  "private": true,
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf build coverage",
    "start": "node build/index.js",
    "start:dev": "tsx src/index.ts",
    "start:background": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-background.ps1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "install:startup": "pnpm build && powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-startup-task.ps1",
    "uninstall:startup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/uninstall-startup-task.ps1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}

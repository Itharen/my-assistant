{
  "manifest_version": 3,
  "name": "My Assistant Companion",
  "version": "0.1.0",
  "description": "Opens the real LinkedIn messaging page beside the local My Assistant review workspace.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:39245/*",
    "http://localhost:39245/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "LinkedIn munkamód megnyitása"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:39245/*",
        "http://localhost:39245/*"
      ],
      "js": ["dist/app-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src http://127.0.0.1:39245 http://localhost:39245"
  }
}

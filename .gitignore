# my-assistant — nincs build kimenet, de általános ignore-ok
node_modules/
.DS_Store
Thumbs.db
*.log
.env
.env.local
cli/config/email-oauth/

# editor / IDE
.vscode/
.idea/
*.swp

.dynamo/logs/
logs/

# activity-monitor: lokál ablak/idle samples — nem pusholjuk (zajos, privát).
# A lifecycle event-jei viszont az action-logba mennek (__agent/log/actions/),
# az pusholva van. Lásd server/activity-monitor/README.md.
server/activity-monitor/data/

# Claude project-level local override (settings.json maga commitolt)
.claude/settings.local.json

# NPM auth tokens — soha ne pusholjuk
.npmrc
*/.npmrc

# Compiled TS output in src (TS-only projekt; a .js/.map build-artifact)
**/src/**/*.js
**/src/**/*.js.map

# Screen Waker local build/test artifacts
screen-waker/build/
screen-waker/coverage/
browser-extension/dist/

# Windows crash dumps
*.stackdump

# Helyzet-adat — SOHA nem kerulhet a repoba (current/principles/location-retention.md)
server/data/

# 🔊 A hang-lánc futásidejű kimenetei — átmeneti nyersanyag, SOHA nem verziózzuk.
# Az átemelt CCAP-kód hozza létre őket (`CV_Recording_ControlService` és `CVO_File_ControlService`),
# a `process.cwd()`-hez képest. ⚠️ A felvételi könyvtárat a szolgáltatás induláskor KIÜRÍTI —
# ha ide bármi verziózott kerülne, azt csendben törölné.
cli/recordings/
cli/_assets/voice-outputs/
recordings/

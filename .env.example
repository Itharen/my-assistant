# My Assistant e-mail tools — configuration schema only, no real account data.
# Copy the required keys into the gitignored project-root `.env`.

# LinkedIn Member Data Portability API (Member). Never commit a real token.
LINKEDIN_MEMBER_ACCESS_TOKEN=replace-with-linkedin-member-access-token

# Gmail (recommended): Desktop OAuth client + Gmail API.
# Create a dedicated Google Cloud project, enable Gmail API, and create a Desktop app OAuth client.
MY_ASSISTANT_EMAIL_GOOGLE_CLIENT_ID=replace-with-desktop-client-id
# Optional for PKCE-capable Desktop clients. Add it only if Google issued one and the token exchange requires it.
# MY_ASSISTANT_EMAIL_GOOGLE_CLIENT_SECRET=replace-with-desktop-client-secret

# The default account used when `--account` is omitted.
MY_ASSISTANT_EMAIL_ACCOUNT_DEFAULT_PROVIDER=gmail
MY_ASSISTANT_EMAIL_ACCOUNT_DEFAULT_ADDRESS=person@gmail.com
MY_ASSISTANT_EMAIL_ACCOUNT_DEFAULT_SENDER_NAME=My Assistant User

# Password-based provider fallback (non-Gmail IMAP/SMTP accounts only).

MY_ASSISTANT_EMAIL_IMAP_HOST=imap.example.com
MY_ASSISTANT_EMAIL_IMAP_PORT=993
MY_ASSISTANT_EMAIL_SMTP_HOST=smtp.example.com
MY_ASSISTANT_EMAIL_SMTP_PORT=465

# MY_ASSISTANT_EMAIL_ACCOUNT_LEGACY_PROVIDER=imap-smtp
# MY_ASSISTANT_EMAIL_ACCOUNT_LEGACY_ADDRESS=person@example.com
# MY_ASSISTANT_EMAIL_ACCOUNT_LEGACY_PASSWORD=replace-me
# MY_ASSISTANT_EMAIL_ACCOUNT_LEGACY_SENDER_NAME=My Assistant User

# Additional accounts need no code change. Example for `--account secondary`:
# MY_ASSISTANT_EMAIL_ACCOUNT_SECONDARY_PROVIDER=gmail
# MY_ASSISTANT_EMAIL_ACCOUNT_SECONDARY_ADDRESS=other@gmail.com
# MY_ASSISTANT_EMAIL_ACCOUNT_SECONDARY_SENDER_NAME=Secondary Account
